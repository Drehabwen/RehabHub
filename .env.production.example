# Backend runtime
DEEPSEEK_API_KEY=replace_with_real_key
CORS_ALLOW_ORIGINS=https://your-domain.com,https://www.your-domain.com
DEBUG_LOGS=false
STRICT_RBAC=false

# Optional frontend explicit overrides
# Same-origin deployment does not require these, but keep them if you want explicit values.
VITE_API_BASE_URL=https://your-domain.com
VITE_WS_URL=wss://your-domain.com/ws/analyze
VITE_MEDVOICE_BASE_URL=https://your-domain.com/medvoice

# Optional ASR credentials
XFYUN_ASR_APPID=
XFYUN_ASR_API_KEY=
XFYUN_ASR_API_SECRET=
